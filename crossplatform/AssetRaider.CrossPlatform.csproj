<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AssetRaider</AssemblyName>
    <RootNamespace>AssetRaider.Desktop</RootNamespace>
    <Version>0.4.1</Version>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <Compile Include="../desktop/Models.cs;../desktop/MusicSite.cs;../desktop/MusicBrowser.cs;../desktop/BrowserData.cs;../desktop/RecorderQueue.cs;../desktop/RecordingPolicyCheck.cs" Link="Shared/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../desktop/Scripts/*.js" LogicalName="AssetRaider.Desktop.Scripts.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
